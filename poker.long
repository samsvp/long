import list("list")

fun is_flush(hand)
    hand
    |> list::sort_by(fun (c) c.suit |> int())
    |> list::mapf_window(
        fun ([x, ..tail] = cards)
            if list::all(tail, fun [x](c) c.suit == x.suit) do
                cards
            end,
        5)

fun is_straight(hand) do
    hand
    |> list::sort_by(fun (c) c.value)
    |> list::mapf_window(
        fun (cards)
            cards
            |> list::map_window(
                cards
                , fun ([x, y]) y - x
                , 2)
            |> list::all(fun (x) x == 1)
        , 5)
end

hand = [
      { suit: :spades, value: 10 }
    , { suit: :heart, value: 9 }
    , { suit: :heart, value: 8 }
    , { suit: :heart, value: 7 }
    , { suit: :heart, value: 6 }
]

is_flush(hand)
|> println()

is_straight(hand)
|> println()
