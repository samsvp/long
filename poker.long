import list("list")

fun is_flush(hand)
| (hand) when len(hand) < 5 do nil
| ([head, ..tail]) do
    list::all(tail, fun [head](c) c.suit == head.suit) and { kind: :flush, hand }
end

fun is_straight(hand) do
    match hand |> list::map(fun (c) c.rank)
    | [2, 3, 4, 5, 14] do { kind: :straight, hand }
    | values when len(values) == 5 do
        if values
            |> list::map_window(fun ([x1, x2]) x2 - x1, 2)
            |> list::all(fun (x) x == 1)
        do
            { kind: :straight, hand }
        end
    | _ do nil
    end
end

fun is_straight_flush(hand)
    hand |> is_flush() and hand |> is_straight() and { kind: :straight_flush, hand }

fun is_n(hand, n) if len(hand) >= n do
    matches =
        hand
        |> list::filter_window(
            fun ([x, ..xs]) list::all(xs, fun [x](y) x.rank == y.rank)
            , n
        )
    if len(matches) > 0 do
        kind = match n
        | 2 do :two
        | 3 do :three
        | 4 do :four
        | 5 do :five
        end

        { kind, hand: matches[-1] }
    end
end

fun is_two(hand)
    is_n(hand, 2)

fun is_three(hand)
    is_n(hand, 3)

fun is_four(hand)
    is_n(hand, 4)

fun is_five(hand)
    is_n(hand, 5)

fun is_two_pair(hand)
| ([x1, x2, x3, x4, x5]) do
    ( (is_two([x1, x2]) and is_two([x3, x4])) or
      (is_two([x1, x2]) and is_two([x4, x5])) or
      (is_two([x2, x3]) and is_two([x4, x5])) ) and
    { kind: :two_pair, hand }
| ([x1, x2, x3, x4] = hand) do
    is_two([x1, x2]) and is_two([x3, x4]) and { kind: :two_pair, hand }
| (_) do nil
end

fun is_full_house(hand)
| ([x1, x2, x3, x4, x5]) do
    ( (is_two([x1, x2]) and is_three([x3, x4, x5])) or
      (is_three([x1, x2, x3]) and is_two([x4, x5])) ) and
    { kind: :full_house, hand }
| (_) do nil
end

fun score_hand(hand) do
    hands =
        hand
        |> list::sort_by(fun (c) c.rank)
        |> list::combinations(5)

    fun score(hand, fns) match fns
    | [fn, ..tail] do
        if hand_rank = fn(hand) do
            hand_rank
        else
            score(hand, tail)
        end
    | [] do
        { kind: :one, hand } # todo max_by on hand
    end

    scores = map h in hands do
        score(h, [ is_straight_flush
                 , is_four
                 , is_full_house
                 , is_flush
                 , is_straight
                 , is_three
                 , is_two_pair
                 , is_two ])
    end
    scores
end


hand =
    [ { suit: :spades, rank: 10 }
    , { suit: :spades, rank: 5 }
    , { suit: :spades, rank: 8 }
    , { suit: :spades, rank: 4 }
    , { suit: :spades, rank: 14 }
    , { suit: :heart, rank: 9 }
    , { suit: :heart, rank: 8 }
    , { suit: :heart, rank: 7 }
    , { suit: :heart, rank: 6 }
    , { suit: :heart, rank: 10 }
    , { suit: :clubs, rank: 10 } ]


for s in score_hand(hand) do
    println(s)
end

