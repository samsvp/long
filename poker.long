import list("list")

fun hand_score({ kind, hand }) do
    fun score(hand) list::reduce(hand, fun (card, acc) acc + (1 << card.rank), 0)

    match kind
    | :five do (1 << 49) + hand[0].rank
    | :straight_flush do (1 << 48) + score(hand)
    | :four do (1 << 47) + (1 << hand[0].rank + 14) + (len(hand) - 4) * hand[-1].rank
    | :full_house do (1 << 46) + (1 << hand[0].rank + 14) + hand[-1].rank
    | :flush do (1 << 45) + score(hand)
    | :straight do (1 << 44) + score(hand)
    | :three do (1 << 43) + (1 << hand[0].rank + 14) + score(hand[3..])
    | :two_pair do (1 << 42) + (1 << hand[0].rank + 14) + hand[2].rank + (len(hand) - 4) * hand[-1].rank / 14
    | :two do (1 << 41) + (1 << hand[0].rank + 14) + score(hand[2..])
    | :one do (1 << 40) + score(hand)
    end
end

fun is_flush(hand)
| (hand) when len(hand) < 5 do nil
| ([head, ..tail]) do
    list::all(tail, fun [head](c) c.suit == head.suit) and { kind: :flush, hand }
end

fun is_straight(hand) do
    match hand |> list::map(fun (c) c.rank)
    | [14, 5, 4, 3, 2] do { kind: :straight, hand: [{ rank: 1, ..hand[0] }, ..hand[1..]] }
    | values when len(values) == 5 do
        if values
            |> list::map_window(fun ([x1, x2]) x2 - x1, 2)
            |> list::all(fun (x) x == -1)
        do
            { kind: :straight, hand }
        end
    | _ do nil
    end
end

fun is_straight_flush(hand)
    hand |> is_flush() and (hand_kind = hand |> is_straight()) and { kind: :straight_flush, ..hand_kind }

fun is_n(hand, n) if len(hand) >= n do
    ranks = hand |> list::map(fun ({ rank, ..}) rank )
    sorted =
        hand
        |> list::sort_by(fun [ranks]({rank, ..}) -list::count(ranks, rank))

    if sorted
        |> list::take(n)
        |> list::all(fun [sorted]({ rank, .. }) rank == sorted[0].rank)
    do
        kind = match n
        | 2 do :two
        | 3 do :three
        | 4 do :four
        | 5 do :five
        end

        { kind, hand: sorted }
    end
end

fun is_two(hand)
    is_n(hand, 2)

fun is_three(hand)
    is_n(hand, 3)

fun is_four(hand)
    is_n(hand, 4)

fun is_five(hand)
    is_n(hand, 5)

fun is_two_pair(hand) do
    two_pair_hand = match hand |> list::map(fun (c) c.rank)
    | [h, h, l, l, _] do hand
    | [h, h, _, l, l] do [hand[0], hand[1], hand[3], hand[4], hand[2]]
    | [_, h, h, l, l] do [hand[1], hand[2], hand[3], hand[4], hand[0]]
    | [h, h, l, l] do hand
    | _ do nil
    end
    two_pair_hand and { kind: :two_pair, hand: two_pair_hand }
end

fun is_full_house(hand) match hand |> list::map(fun (c) c.rank)
| [l, l, h, h, h] do { kind: :full_house, hand: [hand[2], hand[3], hand[4], hand[0], hand[1]] }
| [h, h, h, l, l] do { kind: :full_house, hand }
| _ do nil
end

fun best_hand(hand) do
    fns = [ is_straight_flush
          , is_four
          , is_full_house
          , is_flush
          , is_straight
          , is_three
          , is_two_pair
          , is_two ]

    hand
    |> list::sort_by(fun (c) -c.rank)
    |> list::combinations(5)
    |> list::map(fun [fns](h) do
        fun score(hand, fns) match fns
        | [fn, .._] when hand_rank = fn(hand) do hand_rank
        | [fn, ..tail] do score(hand, tail)
        | [] do { kind: :one, hand }
        end

        score(h, fns)
    end)
    |> list::max_by(fun (h) hand_score(h))
end


hand =
    [ { suit: :spades, rank: 10 }
    , { suit: :spades, rank: 5 }
    , { suit: :spades, rank: 8 }
    , { suit: :spades, rank: 4 }
    , { suit: :spades, rank: 14 }
    , { suit: :heart, rank: 9 }
    , { suit: :heart, rank: 8 }
    , { suit: :heart, rank: 7 }
    , { suit: :heart, rank: 6 }
    , { suit: :heart, rank: 10 }
    , { suit: :clubs, rank: 10 } ]


best_hand(hand)
|> println()

hand2 =
    [ { suit: :spades, rank: 10 }
    , { suit: :spades, rank: 5 }
    , { suit: :clubs, rank: 8 }
    , { suit: :diamonds, rank: 4 }
    , { suit: :hearts, rank: 14 }
    , { suit: :hearts, rank: 2 }
    , { suit: :clubs, rank: 10 } ]


best_hand(hand2)
|> println()
