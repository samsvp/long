fun filter(iter, f) mapf v in iter do
    if f(v) do v else nil end
end

fun rev(lst) do
    fun rev(lst, acc) match lst
    | [] do acc
    | [head, ..tail] do rev(tail, [head, ..acc])
    end

    rev(lst, [])
end

fun mapi(lst, f) do
    fun mapi[f](acc, lst, i) match lst
    | [] do acc
    | [head, ..tail] do
        [ f(head, i), ..acc ]
        |> mapi(tail, i + 1)
    end

    mapi([], lst, 0)
    |> rev()
end

fun reduce(lst, f, v0) do
    fun reduce[f](acc, lst) match lst
    | [] do acc
    | [head, ..tail] do
        f(head, acc)
        |> reduce(tail)
    end

    reduce(v0, lst)
end

fun take(lst, n) do
    lst[..n]
end

fun skip(lst, n) do
    lst[n..]
end
