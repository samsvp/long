import rl("../../build/vendor/raylib")

fun loop(x) do
    if rl::window_should_close() do
        rl::close_window()
    else
        rl::begin_drawing()
        rl::clear_background(rl::RAYWHITE())
        rl::draw_text("Hello from long", 190, 200, 20, rl::DARKGRAY())
        rl::draw_circle_v(rl::vector2(x, 300), 30, rl::RED())
        rl::end_drawing()
        loop((x + 4) % 800)
    end
end

rl::init_window(800, 450, "long + raylib")
rl::set_target_fps(60)
loop(0)
