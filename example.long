fun fib(n)
| (n) when n < 2 do n
| (n) do fib(n - 1) + fib(n - 2)
end

fib(10)
|> println()

fun fizz_buzz(n) do
    ret = match n
    | n when n % 3 == 0 and n % 5 == 0 do "fizzbuzz"
    | n when n % 3 == 0 do "fizz"
    | n when n % 5 == 0 do "buzz"
    | n do n
    end

    println(ret)

    if n > 1 do
        fizz_buzz(n - 1) #tail recursion
    else
        nil
    end
end


import math("math")

math::sin(10)
|> println()

fizz_buzz(15)

fun f(g, arg)
    g(arg)

f(fun (x) println(x), 10)

len([1, 2, 3]) |> println()
len(%{"hello": "world"}) |> println()
len("wow, man") |> println()

import list("std/ll.long")

[1, 2, 3, 4, 5, 6]
|> list::skip(2)
|> list::take(2)
|> println()

fun 1(x) do x end
