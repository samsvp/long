fun fib(n)
| (n) when n < 2 do n
| (n) do fib(n - 1) + fib(n - 2)
end

fib(10)
|> println()

fun fizz_buzz(n) do
    ret = match n
    | n when n % 3 == 0 and n % 5 == 0 do "fizzbuzz"
    | n when n % 3 == 0 do "fizz"
    | n when n % 5 == 0 do "buzz"
    | n do n
    end

    println(ret)

    if n > 1 do
        fizz_buzz(n - 1) #tail recursion
    else
        nil
    end
end


import math("math")

math::sin(10)
|> println()

fizz_buzz(15)

fun f(g, arg)
    g(arg)

f(fun (x) println(x), 10)

len([1, 2, 3]) |> println()
len(%{"hello": "world"}) |> println()
len("wow, man") |> println()

import list("std/ll.long")

[1, 2, 3, 4, 5, 6]
|> list::skip(2)
|> list::take(2)
|> println()

import list("list")

fun rev(lst) do
    fun rev(lst, acc) match lst
    | [] do acc
    | [head, ..tail] do rev(tail, [ head, ..acc ])
    end

    rev(lst, [])
end

list::map([1, 2, 3], fun (x) 3 * x)
|> println()

list::zip([1, 2, 3], [4, 5, 6])
|> println()

list::zip([1, 2, 3, 5], [4, 5, 6, 8])
|> list::shuffle()
|> list::take(2)
|> println()

[1, 2, 3, 4]
|> list::mapf_window(
    fun ([x1, x2] = lst)
        if x1 * x2 > 5 do
            lst
        end,
    2)
|> println()

[5, 2, 7, 6]
|> list::sort()
|> println()

[5, 2, 7, 6]
|> list::all(fun (x) x < 5)
|> println()

[:heart, :cup, :blah]
|> list::sort_by(int)
|> println()

1 and 2
|> println()
